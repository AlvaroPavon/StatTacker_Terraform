# ============================================================
# StatTracker - Terraform Variables para Proxmox
# ============================================================
# Copia este archivo a terraform.tfvars y rellena tus valores
# NO subas terraform.tfvars a Git (contiene secrets)
# ============================================================

# --- Proxmox Connection ---
pm_api_url          = "https://TU_IP_PROXMOX:8006/api2/json"
pm_api_token_id     = "root@pam!terraform"
pm_api_token_secret = "TU_API_TOKEN_SECRET"

# --- Proxmox Infrastructure ---
pm_node     = "pve"
pm_template = "debian-12-template"
pm_pool     = ""
pm_storage  = "local-lvm"
pm_bridge   = "vmbr0"

# --- VM Configuration ---
vm_name       = "stattracker"
vm_cores      = 2
vm_memory     = 2048
vm_disk_size  = "20G"

# --- Cloud-Init User ---
ci_user     = "stattracker"
ci_password = "TU_PASSWORD_AQUI"

# --- SSH (opcional, deja vacio si no usas) ---
ssh_key_file = ""

# --- GitHub Repository ---
github_repo   = "https://github.com/AlvaroPavon/StatTracker"
github_branch = "main"

# --- Database ---
db_name          = "proyecto_imc"
db_user          = "stattracker"
db_password      = "Stattracker2025!"
db_root_password = "MySQLRoot2025!"
